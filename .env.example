# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). The anon key is safe
# to expose in client code — it's designed for that — access is controlled
# by Row Level Security policies (see supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
